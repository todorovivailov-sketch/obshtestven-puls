# Копирай като .env и попълни с твоите Supabase данни
VITE_SUPABASE_URL=https://ТВОЯ_ПРОЕКТ.supabase.co
VITE_SUPABASE_ANON_KEY=твоя_anon_key

# За Netlify Functions (server-side) — добавяй в Netlify → Environment Variables
SUPABASE_URL=https://ТВОЯ_ПРОЕКТ.supabase.co
SUPABASE_SERVICE_KEY=твоя_service_role_key
ADMIN_PASSWORD_HASH=генерирай_с_bcrypt

# JWT secret за admin сесия
JWT_SECRET=минимум_32_случайни_символа
