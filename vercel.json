{
  "rewrites": [
    {
      "source": "/anketi/:id",
      "has": [{"type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|vkShare).*"}],
      "destination": "/api/og?type=poll&id=:id"
    },
    {
      "source": "/komentari/:id",
      "has": [{"type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|vkShare).*"}],
      "destination": "/api/og?type=article&id=:id"
    },
    {
      "source": "/prevodach/:id",
      "has": [{"type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|vkShare).*"}],
      "destination": "/api/og?type=policy&id=:id"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
